---
import MainLayout from "@/layouts/MainLayout.astro";
import BackLink from "@/components/BackLink.astro";
import { type LucideIcon } from "lucide-react";

interface Props {
  title: string;
  description: string;
  icon: LucideIcon;
  pageTitle?: string;
}

const { title, description, icon: Icon, pageTitle } = Astro.props;
---

<MainLayout title={pageTitle ?? title} description={description}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10 sm:py-14">
    <div class="mb-10">
      <BackLink href="/#topik" label="Kembali ke semua koleksi" />
    </div>

    <header class="mb-10 max-w-3xl">
      <div class="flex items-center gap-3 mb-4">
        <Icon className="h-6 w-6 shrink-0 text-brand" />
        <h1 class="text-3xl sm:text-4xl font-bold text-fg tracking-tight">
          {title}
        </h1>
      </div>
      <p class="text-muted text-lg leading-relaxed max-w-2xl">{description}</p>
      <div class="w-16 h-0.5 bg-brand mt-8"></div>
    </header>

    <slot />
  </div>
</MainLayout>
