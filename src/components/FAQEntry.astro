---
import { render, type CollectionEntry } from "astro:content";
import { ChevronDown } from "lucide-react";

interface Props {
  entry: CollectionEntry<"faq">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<details id={entry.id} class="group scroll-mt-24 border-b border-border py-5 last:border-b-0 open:pb-7">
  <summary
    class="flex items-center justify-between gap-4 cursor-pointer list-none rounded-md font-medium text-fg transition-colors hover:text-brand"
  >
    <span>{entry.data.question}</span>
    <ChevronDown
      className="h-4 w-4 text-muted shrink-0 transition-transform duration-200 group-open:rotate-180"
    />
  </summary>
  <div class="mt-4 max-w-3xl prose dark:prose-invert text-muted">
    <Content />
  </div>
</details>

<script>
  const target = location.hash
    ? document.querySelector<HTMLDetailsElement>(`details${location.hash}`)
    : null;
  if (target) target.open = true;
</script>
