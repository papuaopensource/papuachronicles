---
import { ArrowRight, type LucideIcon } from "lucide-react";

interface Props {
  title: string;
  description: string;
  link: string;
  icon: LucideIcon;
  horizontal?: boolean;
  class?: string;
}

const {
  title,
  description,
  link,
  icon: Icon,
  horizontal = false,
  class: className,
} = Astro.props;
---

{
  horizontal ? (
    <a
      href={link}
      class:list={[
        "group flex items-center gap-4 rounded-xl border border-border bg-surface p-5 transition-[background-color,border-color,transform] duration-150 hover:-translate-y-0.5 hover:border-brand/45 hover:bg-surface-hover active:scale-[0.99]",
        className,
      ]}
    >
      <Icon className="h-5 w-5 shrink-0 text-muted transition-colors group-hover:text-brand" />
      <div class="flex-1 min-w-0">
        <h2 class="font-medium leading-snug">{title}</h2>
        <p class="text-sm text-muted leading-relaxed mt-0.5">{description}</p>
      </div>
      <ArrowRight className="h-4 w-4 shrink-0 text-muted -translate-x-1 group-hover:translate-x-0 group-hover:text-fg transition-all" />
    </a>
  ) : (
    <a
      href={link}
      class:list={[
        "group block min-h-48 rounded-xl border border-border bg-surface p-5 transition-[background-color,border-color,transform] duration-150 hover:-translate-y-0.5 hover:border-brand/45 hover:bg-surface-hover active:scale-[0.99]",
        className,
      ]}
    >
      <div class="flex items-center justify-between mb-5">
        <Icon className="h-5 w-5 text-muted transition-colors group-hover:text-brand" />
        <ArrowRight className="h-4 w-4 text-muted opacity-0 transition-[opacity,transform] group-hover:opacity-100 group-hover:translate-x-0.5" />
      </div>
      <h2 class="font-medium leading-snug mb-1.5">{title}</h2>
      <p class="text-sm text-muted leading-relaxed">{description}</p>
    </a>
  )
}
