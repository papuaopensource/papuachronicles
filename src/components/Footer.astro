---
import Link from "@/components/Link.astro";
import { Sun, Moon } from "lucide-react";
---

<footer class="border-t border-border mt-auto">
  <div
    class="max-w-6xl mx-auto flex flex-col sm:flex-row sm:justify-between items-center gap-6 px-4 sm:px-6 py-10"
  >
    <p class="text-sm text-muted">&copy; 2026 Papua Open Source</p>

    <div class="flex flex-col-reverse sm:flex-row items-center gap-5 sm:gap-6">
      <nav class="flex items-center gap-6 text-sm text-muted">
        <Link
          href="/tentang/"
          class="hover:text-fg transition-colors"
          activeClass="text-fg"
        >
          Tentang
        </Link>
        <Link
          href="/kebijakan-privasi/"
          class="hover:text-fg transition-colors"
          activeClass="text-fg"
        >
          Privasi
        </Link>
        <Link
          href="/ketentuan-layanan/"
          class="hover:text-fg transition-colors"
          activeClass="text-fg"
        >
          Layanan
        </Link>
      </nav>

      <div
        class="inline-flex items-center rounded-lg border border-border p-0.5"
      >
        <button
          type="button"
          data-theme-set="light"
          aria-label="Gunakan tema terang" aria-pressed="false"
          class="theme-opt flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs text-muted transition-colors cursor-pointer"
        >
          <Sun className="h-3.5 w-3.5" />
          Terang
        </button>
        <button
          type="button"
          data-theme-set="dark"
          aria-label="Gunakan tema gelap" aria-pressed="false"
          class="theme-opt flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs text-muted transition-colors cursor-pointer"
        >
          <Moon className="h-3.5 w-3.5" />
          Gelap
        </button>
      </div>
    </div>
  </div>
</footer>
