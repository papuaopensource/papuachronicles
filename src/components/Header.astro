---
import Link from "@/components/Link.astro";
import { Menu, X } from "lucide-react";

const nav = [
  { href: "/#topik", label: "Jelajahi" },
  { href: "/tentang/", label: "Tentang" },
];
---

<header class="sticky top-0 z-50 border-b border-border/80 bg-bg/90 backdrop-blur-xl">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <a href="/" class="group inline-flex items-center gap-2.5 rounded-md" aria-label="Papua Chronicles — Beranda">
      <span class="h-5 w-1 bg-brand" aria-hidden="true"></span>
      <span class="text-sm font-bold tracking-tight sm:text-base">Papua Chronicles</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Navigasi utama">
      {nav.map((item) => (
        <Link href={item.href} class="rounded-lg px-3 py-2 text-sm text-muted transition-colors hover:bg-surface-hover hover:text-fg" activeClass="bg-surface-hover text-fg font-medium">
          {item.label}
        </Link>
      ))}
    </nav>

    <button type="button" data-menu-toggle class="grid h-10 w-10 place-items-center rounded-lg border border-border text-fg md:hidden" aria-expanded="false" aria-controls="mobile-menu" aria-label="Buka menu">
      <Menu className="menu-open h-5 w-5" />
      <X className="menu-close hidden h-5 w-5" />
    </button>
  </div>

  <nav id="mobile-menu" data-mobile-menu class="hidden border-t border-border bg-bg px-4 py-3 md:hidden" aria-label="Navigasi seluler">
    <div class="mx-auto grid max-w-6xl gap-1">
      {nav.map((item) => (
        <Link href={item.href} class="rounded-lg px-3 py-2.5 text-sm text-muted hover:bg-surface-hover hover:text-fg" activeClass="bg-surface-hover text-fg font-medium">
          {item.label}
        </Link>
      ))}
    </div>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");
  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") !== "true";
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Tutup menu" : "Buka menu");
    menu?.classList.toggle("hidden", !open);
    toggle.querySelector(".menu-open")?.classList.toggle("hidden", open);
    toggle.querySelector(".menu-close")?.classList.toggle("hidden", !open);
  });
</script>
