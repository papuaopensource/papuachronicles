---
import MainLayout from "@/layouts/MainLayout.astro";
import TopicCard from "@/components/TopicCard.astro";

import {
  Github,
  ArrowUpRight,
  HelpCircle,
  BookOpen,
  Image as ImageIcon,
  Landmark,
  Map,
  Languages,
  Palette,
  Mountain,
  Newspaper,
  Award,
  Library,
  GitPullRequest,
} from "lucide-react";

const menuList = [
  {
    title: "FAQ",
    description:
      "Pertanyaan yang sering diajukan tentang Papua dan jawabannya.",
    link: "/faq/",
    icon: HelpCircle,
  },
  {
    title: "Glosarium",
    description: "Kumpulan istilah penting terkait Papua dan penjelasannya.",
    link: "/glosarium/",
    icon: BookOpen,
  },
  {
    title: "Galeri",
    description:
      "Koleksi foto yang menampilkan keindahan alam dan budaya Papua.",
    link: "/galeri/",
    icon: ImageIcon,
  },
  {
    title: "Jejak Sejarah",
    description:
      "Sejarah Papua dan peristiwa penting yang membentuknya hingga kini.",
    link: "/sejarah/",
    icon: Landmark,
  },
  {
    title: "Wilayah Adat",
    description: "Tujuh wilayah adat di Tanah Papua dan suku-suku penghuninya.",
    link: "/wilayah-adat/",
    icon: Map,
  },
  {
    title: "Bahasa Daerah",
    description:
      "Ratusan bahasa daerah yang hidup di Tanah Papua dan persebarannya.",
    link: "/bahasa/",
    icon: Languages,
  },
  {
    title: "Seni & Kerajinan",
    description:
      "Ukiran Asmat, noken, lukisan kulit kayu, dan karya seni khas Papua.",
    link: "/seni/",
    icon: Palette,
  },
  {
    title: "Alam Papua",
    description: "Geografi, keanekaragaman hayati, dan lingkungan alam Papua.",
    link: "/alam/",
    icon: Mountain,
  },
  {
    title: "Papua Kontemporer",
    description:
      "Situasi Papua saat ini: perkembangan sosial, ekonomi, dan politik terkini.",
    link: "/kontemporer/",
    icon: Newspaper,
  },
  {
    title: "Tokoh Papua",
    description: "Profil tokoh-tokoh penting dari Papua di berbagai bidang.",
    link: "/tokoh/",
    icon: Award,
  },
  {
    title: "Sumber Bacaan",
    description:
      "Buku, artikel, dan tautan untuk mempelajari Papua lebih lanjut.",
    link: "/bacaan/",
    icon: Library,
  },
  {
    title: "Cara Berkontribusi",
    description: "Cara ikut menambah atau memperbaiki konten di situs ini.",
    link: "/kontribusi/",
    icon: GitPullRequest,
  },
];

const availableLinks = new Set(["/faq/", "/glosarium/", "/sejarah/", "/wilayah-adat/", "/tokoh/"]);
const available = menuList.filter((item) => availableLinks.has(item.link));
const upcoming = menuList.filter((item) => !availableLinks.has(item.link) && item.link !== "/kontribusi/");
const contribute = menuList[menuList.length - 1]; // Cara Berkontribusi
---

<MainLayout
  title="Beranda"
  description="Kumpulan informasi terbuka tentang Papua — sejarah, budaya, alam, dan kehidupan masyarakatnya."
>
  <!-- Hero -->
  <section>
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-20 sm:py-28">
    <h1 class="max-w-3xl text-4xl sm:text-6xl font-bold tracking-[-0.04em] leading-[1.05] text-balance">
      Sejarah, budaya, dan kehidupan di Tanah Papua
    </h1>
    <p class="mt-7 text-lg text-muted max-w-2xl leading-relaxed">
      Papua Chronicles mengumpulkan informasi tentang Papua dalam bahasa Indonesia yang mudah dibaca, terbuka untuk diperiksa, dan dapat diperbaiki bersama.
    </p>

    <div
      class="flex flex-wrap items-center gap-x-5 gap-y-3 mt-10"
    >
      <a
        href="#topik"
        class="bg-brand text-white px-5 py-3 rounded-lg text-sm font-semibold hover:brightness-110 transition-[filter]"
      >
        Mulai jelajahi
      </a>
      <a
        href="https://github.com/papuaopensource/papuachronicles"
        target="_blank"
        rel="noreferrer"
        class="inline-flex items-center gap-2 rounded-full border border-border bg-surface px-4 py-2.5 text-sm font-medium text-fg transition-[background-color,border-color,transform] hover:border-fg/30 hover:bg-surface-hover active:scale-[0.96]"
      >
        <Github className="h-4 w-4" />
        Lihat repositori GitHub
        <ArrowUpRight className="h-3.5 w-3.5 text-muted" />
      </a>
    </div>
  </section>

  <!-- Topic grid -->
  <section id="topik" class="max-w-6xl mx-auto px-4 sm:px-6 py-20 scroll-mt-20">
    <div class="mb-8">
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight">Jelajahi koleksi</h2>
      <p class="mt-2 text-sm text-muted">Pilih topik yang ingin dipelajari.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {available.map((menu) => <TopicCard {...menu} />)}
    </div>
    <div class="mt-10"><TopicCard {...contribute} horizontal /></div>
  </section>

  <section class="border-t border-border">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-16">
      <div class="mb-7"><h2 class="text-xl font-semibold">Koleksi yang sedang disiapkan</h2>
      <p class="mt-2 text-sm text-muted">Bagian ini belum dapat dibuka.</p></div>
      <div class="grid grid-cols-2 gap-x-6 gap-y-5 sm:grid-cols-3 lg:grid-cols-5">
        {upcoming.map(({ title, icon: Icon }) => (
          <div class="flex items-center gap-3 text-muted">
            <Icon className="h-4 w-4 shrink-0" />
            <span class="text-sm">{title}</span>
          </div>
        ))}
      </div>
    </div>
  </section>
</MainLayout>
