---
import MainLayout from "@/layouts/MainLayout.astro";
import TopicCard from "@/components/TopicCard.astro";

import {
  ArrowUpRight,
  HelpCircle,
  BookOpen,
  Image as ImageIcon,
  Landmark,
  Map,
  Languages,
  Palette,
  Mountain,
  Newspaper,
  Award,
  Library,
  GitPullRequest,
} from "lucide-react";

const menuList = [
  {
    title: "FAQ",
    description:
      "Pertanyaan yang sering diajukan tentang Papua dan jawabannya.",
    link: "/faq/",
    icon: HelpCircle,
  },
  {
    title: "Glosarium",
    description: "Kumpulan istilah penting terkait Papua dan penjelasannya.",
    link: "/glosarium/",
    icon: BookOpen,
  },
  {
    title: "Galeri",
    description:
      "Koleksi foto yang menampilkan keindahan alam dan budaya Papua.",
    link: "/galeri/",
    icon: ImageIcon,
  },
  {
    title: "Jejak Sejarah",
    description:
      "Sejarah Papua dan peristiwa penting yang membentuknya hingga kini.",
    link: "/sejarah/",
    icon: Landmark,
  },
  {
    title: "Wilayah Adat",
    description: "Tujuh wilayah adat di Tanah Papua dan suku-suku penghuninya.",
    link: "/wilayah-adat/",
    icon: Map,
  },
  {
    title: "Bahasa Daerah",
    description:
      "Ratusan bahasa daerah yang hidup di Tanah Papua dan persebarannya.",
    link: "/bahasa/",
    icon: Languages,
  },
  {
    title: "Seni & Kerajinan",
    description:
      "Ukiran Asmat, noken, lukisan kulit kayu, dan karya seni khas Papua.",
    link: "/seni/",
    icon: Palette,
  },
  {
    title: "Alam Papua",
    description: "Geografi, keanekaragaman hayati, dan lingkungan alam Papua.",
    link: "/alam/",
    icon: Mountain,
  },
  {
    title: "Papua Kontemporer",
    description:
      "Situasi Papua saat ini: perkembangan sosial, ekonomi, dan politik terkini.",
    link: "/kontemporer/",
    icon: Newspaper,
  },
  {
    title: "Tokoh Papua",
    description: "Profil tokoh-tokoh penting dari Papua di berbagai bidang.",
    link: "/tokoh/",
    icon: Award,
  },
  {
    title: "Sumber Bacaan",
    description:
      "Buku, artikel, dan tautan untuk mempelajari Papua lebih lanjut.",
    link: "/bacaan/",
    icon: Library,
  },
  {
    title: "Cara Berkontribusi",
    description: "Cara ikut menambah atau memperbaiki konten di situs ini.",
    link: "/kontribusi/",
    icon: GitPullRequest,
  },
];

const featured = menuList.slice(0, 2); // FAQ, Glosarium
const middle = menuList.slice(2, -1); // topik utama
const contribute = menuList[menuList.length - 1]; // Cara Berkontribusi

// Lebar kartu agar baris terakhir yang tidak penuh tetap rata tengah
const middleCardWidth =
  "w-full sm:w-[calc(50%-0.5rem)] lg:w-[calc(33.333%-0.667rem)]";
---

<MainLayout
  title="Beranda"
  description="Kumpulan informasi terbuka tentang Papua — sejarah, budaya, alam, dan kehidupan masyarakatnya."
>
  <!-- Hero -->
  <section class="max-w-5xl mx-auto px-4 pt-28 pb-20">
    <h1 class="text-4xl sm:text-5xl font-bold tracking-tight leading-[1.1]">
      Jelajahi sejarah, budaya, dan alam Papua
    </h1>

    <div class="w-16 h-px bg-border my-8"></div>

    <p class="text-lg text-muted max-w-xl leading-relaxed">
      Papua Chronicles adalah kumpulan informasi terbuka tentang Papua, dibuat
      dan dirawat bersama oleh komunitas Papua Open Source.
    </p>

    <div
      class="flex flex-wrap items-center gap-x-5 gap-y-3 mt-10"
    >
      <a
        href="#topik"
        class="bg-fg text-bg px-5 py-2.5 rounded-lg text-sm font-medium hover:opacity-90 transition-opacity"
      >
        Mulai jelajahi
      </a>
      <a
        href="https://github.com/papuaopensource/papuachronicles"
        target="_blank"
        rel="noreferrer"
        class="text-sm text-muted hover:text-fg transition-colors inline-flex items-center gap-1"
      >
        Berkontribusi di GitHub
        <ArrowUpRight className="h-4 w-4" />
      </a>
    </div>
  </section>

  <!-- Topic grid -->
  <section id="topik" class="max-w-5xl mx-auto px-4 pb-28 scroll-mt-12">
    <p class="text-xs font-medium uppercase tracking-widest text-muted mb-4">
      Jelajahi Topik
    </p>

    <div class="space-y-4">
      <!-- Baris 1: FAQ + Glosarium (2 kolom) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {featured.map((menu) => <TopicCard {...menu} />)}
      </div>

      <!-- Topik utama (3 kolom, baris terakhir rata tengah) -->
      <div class="flex flex-wrap justify-center gap-4">
        {middle.map((menu) => <TopicCard {...menu} class={middleCardWidth} />)}
      </div>

      <!-- Baris terakhir: Cara Berkontribusi (1 kolom penuh, layout horizontal) -->
      <TopicCard {...contribute} horizontal />
    </div>
  </section>
</MainLayout>
