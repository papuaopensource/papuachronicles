---
import { getCollection, render } from "astro:content";
import MainLayout from "@/layouts/MainLayout.astro";
import BackLink from "@/components/BackLink.astro";
import DaftarPustaka from "@/components/DaftarPustaka.astro";

export async function getStaticPaths() {
  const entries = await getCollection("wilayah");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<MainLayout
  title={entry.data.name}
  description={entry.data.description}
>
  <article class="max-w-6xl mx-auto px-4 sm:px-6 py-10 sm:py-14">
    <div class="mb-10">
      <BackLink href="/wilayah-adat/" label="Kembali ke daftar wilayah" />
    </div>

    <header class="mb-12 max-w-3xl">
      <p class="text-xs font-medium uppercase tracking-widest text-muted mb-3">
        Wilayah Adat {String(entry.data.order ?? "").padStart(2, "0")}
      </p>
      <h1 class="text-4xl sm:text-5xl font-bold text-fg tracking-tight mb-4 text-balance">
        {entry.data.name}
      </h1>
      <p class="text-lg text-muted leading-relaxed max-w-2xl mb-8">
        {entry.data.description}
      </p>

      <div class="grid grid-cols-1 gap-6 border-y border-border py-6 sm:grid-cols-[10rem_1fr]">
        <div>
          <p class="text-xs font-medium uppercase tracking-wider text-muted">Pusat utama</p>
          <p class="mt-1.5 font-medium text-fg">{entry.data.ibukota}</p>
        </div>
        <div>
          <p class="text-xs font-medium uppercase tracking-wider text-muted">Masyarakat adat</p>
          <ul class="mt-2 flex flex-wrap gap-2" aria-label="Masyarakat adat di wilayah ini">
            {entry.data.suku.map((suku: string) => (
              <li class="rounded-full border border-border px-3 py-1 text-xs text-muted">{suku}</li>
            ))}
          </ul>
        </div>
      </div>
    </header>

    <div class="prose dark:prose-invert max-w-3xl prose-headings:scroll-mt-24">
      <Content />
    </div>

    {
      entry.data.references && entry.data.references.length > 0 && (
        <div class="max-w-3xl"><DaftarPustaka references={entry.data.references} /></div>
      )
    }
  </article>
</MainLayout>
